# MobiWork Open API credentials
MOBIWORK_USER=
MOBIWORK_TOKEN=

# SharePoint / Microsoft Graph target
SHAREPOINT_HOST=example.sharepoint.com
SHAREPOINT_SITE_PATH=/sites/YourSite
SHAREPOINT_LIBRARY=YourDocumentLibrary
SHAREPOINT_DRIVE_ID=
SHAREPOINT_MAX_RETRIES=6
SHAREPOINT_TIMEOUT_SECONDS=120

# Existing report sync
SYNC_SCOPE=today
LOOKBACK_DAYS=1
DRY_RUN=true
LOG_LEVEL=INFO

# Rolling image sync
IMAGE_SYNC_ENABLED=true
IMAGE_SOURCE_REPORT=visit
IMAGE_ROOT_FOLDER=Data anh
IMAGE_URL_FIELD=hinh_anh
IMAGE_DATE_FIELD=ngay
IMAGE_EMPLOYEE_FIELD=ten_nhan_vien
IMAGE_CUSTOMER_FIELD=ma_kh
IMAGE_SEQUENCE_FIELD=stt_hinh
IMAGE_REQUIRE_GHI_TON=false
IMAGE_REQUEST_TIMEOUT_SECONDS=30
IMAGE_MAX_DOWNLOAD_RETRIES=2
IMAGE_MAX_BYTES=20971520
IMAGE_ALLOWED_HOSTS=dmsimages.mobiwork.vn
IMAGE_FORCE_FROM_DATE=
IMAGE_FAIL_ON_PARTIAL=false
IMAGE_SYNC_MAX_UPLOADS_PER_RUN=1500
# Soft runtime budget. Leave a wide margin before the CI runner hard timeout so
# state + manifest can be checkpointed and the next run can resume safely.
IMAGE_SYNC_MAX_RUNTIME_SECONDS=7200

# Image Scoring V2.3 + KPI V2.4
AI_SHAREPOINT_ASSET_ROOT=Model Assets
AI_SYNC_ASSETS=true
RUNTIME_ROOT=runtime
AI_ASSET_ROOT=runtime/ai
AI_REFERENCE_DIR=runtime/ai/reference
AI_WEIGHTS_DIR=runtime/ai/weights
AI_CACHE_DIR=runtime/cache
KPI_TEMPLATE_DIR=runtime/ai/template
KPI_OUTPUT_DIR=runtime/output
KPI_SHAREPOINT_ROOT=KPI
CUSTOMER_HISTORY_REMOTE_PATH=KPI/History/customer_history.csv
AI_DOWNLOAD_WORKERS=8