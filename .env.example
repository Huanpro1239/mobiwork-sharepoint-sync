# MobiWork Open API credentials
MOBIWORK_USER=
MOBIWORK_TOKEN=

# SharePoint / Microsoft Graph target
SHAREPOINT_HOST=example.sharepoint.com
SHAREPOINT_SITE_PATH=/sites/YourSite
SHAREPOINT_LIBRARY=YourDocumentLibrary
SHAREPOINT_DRIVE_ID=
SHAREPOINT_MAX_RETRIES=6
SHAREPOINT_TIMEOUT_SECONDS=120

# Existing report sync
SYNC_SCOPE=today
LOOKBACK_DAYS=1
DRY_RUN=true
LOG_LEVEL=INFO

# Combined Visit image metadata + Bill detail workbook
DATA_CHAM_ANH_ROOT_FOLDER=05_DataChamAnh

# Promotion Bonus (Báo cáo trả thưởng) via the DMS web Paybonus service.
# Copy from a signed-in DMS browser session (cookies email/tokenkey/alias).
# Never commit real values; store them as GitHub Actions secrets.
MOBIWORK_WEB_EMAIL=
MOBIWORK_WEB_TOKENKEY=
MOBIWORK_WEB_ALIAS=
# Optional: defaults to the orgid on the programme catalogue.
MOBIWORK_ORG_ID=
# auto = web source when the three secrets exist, else legacy OpenAPI.
PROMOTION_BONUS_SOURCE=auto
# Cách tính: blank=default, 0, 1, -1, 2
PROMOTION_BONUS_STTT=
